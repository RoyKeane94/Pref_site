# Django
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=.up.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app

# Railway Postgres — paste from Railway → Postgres → Variables
DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway
DATABASE_PUBLIC_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
PGHOST=postgres.railway.internal
PGPORT=5432
PGUSER=postgres
PGPASSWORD=PASSWORD
PGDATABASE=railway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=railway
POSTGRES_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway
